#!/bin/bash
# MatGPT.app launcher — runs the Electron app
SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)"
REPO="$(dirname "$(dirname "$(dirname "$SCRIPT_PATH")")")"
ELECTRON="$REPO/electron/node_modules/.bin/electron"

if [ ! -f "$ELECTRON" ]; then
  osascript -e "display alert \"MatGPT\" message \"Electron not installed yet.\n\nRun this in Terminal:\n\ncd '$REPO/electron' && npm install\""
  exit 1
fi

cd "$REPO/electron"
exec "$ELECTRON" .
